{
  "name": "digitalparadise",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "check:ux": "node scripts/ux-regression-check.cjs",
    "check:quality": "npm run check:ux",
    "ux:review:new": "node scripts/create-ux-review.cjs"
  },
  "expo": {
